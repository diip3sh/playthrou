{
  "name": "playthru",
  "version": "0.1.0",
  "description": "Scripted product demos on your real UI. A cursor that glides, clicks and types, and a camera that zooms in on what matters. Zero dependencies.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "size": "node scripts/size.mjs",
    "dev": "npm run build && node scripts/serve.mjs"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react": "^19.3.1",
    "terser": "^5.51.2",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "demo",
    "product-demo",
    "cursor",
    "animation",
    "landing-page",
    "screen-studio",
    "walkthrough",
    "zero-dependency"
  ],
  "license": "MIT"
}
