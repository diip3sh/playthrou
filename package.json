{
  "name": "playthru",
  "version": "0.1.2",
  "description": "Scripted product demos on your real UI. A cursor that glides, clicks and types, and a camera that zooms in on what matters. Zero dependencies.",
  "homepage": "https://playthrou.diip3sh.xyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diip3sh/playthrou.git"
  },
  "bugs": {
    "url": "https://github.com/diip3sh/playthrou/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "size": "node scripts/size.mjs",
    "dev": "npm run build && node scripts/serve.mjs",
    "prepublishOnly": "npm run build",
    "changeset": "changeset",
    "release": "npm run build && changeset publish"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@types/react": "^19.3.0",
    "react": "^19.3.1",
    "terser": "^5.51.2",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "demo",
    "product-demo",
    "cursor",
    "animation",
    "landing-page",
    "screen-studio",
    "walkthrough",
    "zero-dependency"
  ],
  "license": "MIT"
}
