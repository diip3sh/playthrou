---
import P from "../components/P.astro";
import Section from "../components/Section.astro";
import { table } from "../lib/styles";

const NUMBERS: Array<{ job: string; value: string[]; why: string }> = [
  {
    job: "Glide",
    value: ["420ms + 0.34ms/px", "max 980ms"],
    why: "Short hops shouldn't feel sluggish and long ones shouldn't teleport. A move across a 900px hero lands just under a second.",
  },
  {
    job: "Arc",
    value: ["10% of the distance"],
    why: "Hands move from the wrist, in a slight curve. A straight line reads as a robot; much more reads as drunk.",
  },
  {
    job: "Settle",
    value: ["180ms"],
    why: "The beat between arriving and clicking. Without it, eyes can't catch up to what got clicked.",
  },
  {
    job: "Press",
    value: ["90ms", "cursor at 84%"],
    why: "A real click is 60 to 120ms. The squeeze makes it readable at video frame rates.",
  },
  {
    job: "Ripple",
    value: ["560ms"],
    why: "Long enough to show up in a 30fps recording, gone before the next action.",
  },
  {
    job: "Typing",
    value: ["48ms + 0–42ms", "+150ms after punctuation"],
    why: "Around 130 words a minute: quick enough to not bore you, uneven enough to look human. It is seeded, so every loop types the same.",
  },
  {
    job: "Zoom",
    value: ["1050ms", "1.3× to 2.2×"],
    why: "The target fills half the stage. Below 1.3× a zoom looks like a mistake; above 2.2× you lose where you are. If the target can't fit at 1.3×, as on a phone, the camera stays out.",
  },
  {
    job: "Follow",
    value: ["8% from an edge", "nudge to 22%"],
    why: "While zoomed in, the camera pans only when the cursor heads for the edge, and only as far as it must. It never recenters on every move.",
  },
  {
    job: "Gap",
    value: ["240ms between steps"],
    why: "Sequential actions should read as separate. run() steps are bookkeeping and get no gap.",
  },
  {
    job: "Hold",
    value: ["1.9s"],
    why: "The payoff has to land before the loop starts over.",
  },
];
---

<Section id="numbers" title="The numbers">
  <P>
    There is no <code class="code-inline">speed</code>, <code class="code-inline">easing</code> or
    <code class="code-inline">duration</code> option, and there won't be one. The numbers are the product: each one is a
    decision you no longer have to make.
  </P>
  <div class={table.root}>
    <dl class={table.list}>
      {
        NUMBERS.map((n) => (
          <div class={table.row}>
            <dt class={table.term}>
              <span class="font-sans text-sm font-medium">{n.job}</span>
              {n.value.map((v) => (
                <span class="text-gray-1100">{v}</span>
              ))}
            </dt>
            <dd class={table.desc}>{n.why}</dd>
          </div>
        ))
      }
    </dl>
  </div>
  <P>
    One easing curve, a cubic in-out, drives both the cursor and the camera, so the two never disagree about when a move
    starts or lands.
  </P>
</Section>
