---
import P from "../components/P.astro";
import Section from "../components/Section.astro";
import RefTable, { type RefRow } from "../components/kumo/RefTable";

const NUMBERS: RefRow[] = [
  {
    label: "Glide",
    code: ["420ms + 0.34ms/px", "max 980ms"],
    desc: "Short hops shouldn't feel sluggish and long ones shouldn't teleport. A move across a 900px hero lands just under a second.",
  },
  {
    label: "Arc",
    code: ["10% of the distance"],
    desc: "Hands move from the wrist, in a slight curve. A straight line reads as a robot; much more reads as drunk.",
  },
  {
    label: "Settle",
    code: ["180ms"],
    desc: "The beat between arriving and clicking. Without it, eyes can't catch up to what got clicked.",
  },
  {
    label: "Press",
    code: ["90ms", "cursor at 84%"],
    desc: "A real click is 60 to 120ms. The squeeze makes it readable at video frame rates.",
  },
  {
    label: "Ripple",
    code: ["560ms"],
    desc: "Long enough to show up in a 30fps recording, gone before the next action.",
  },
  {
    label: "Typing",
    code: ["48ms + 0–42ms", "+150ms after punctuation"],
    desc: "Around 130 words a minute: quick enough to not bore you, uneven enough to look human. It is seeded, so every loop types the same.",
  },
  {
    label: "Zoom",
    code: ["1050ms", "1.3× to 2.2×"],
    desc: "The target fills half the stage. Below 1.3× a zoom looks like a mistake; above 2.2× you lose where you are. If the target can't fit at 1.3×, as on a phone, the camera stays out.",
  },
  {
    label: "Follow",
    code: ["8% from an edge", "nudge to 22%"],
    desc: "While zoomed in, the camera pans only when the cursor heads for the edge, and only as far as it must. It never recenters on every move.",
  },
  {
    label: "Gap",
    code: ["240ms between steps"],
    desc: "Sequential actions should read as separate. run() steps are bookkeeping and get no gap.",
  },
  {
    label: "Hold",
    code: ["1.9s"],
    desc: "The payoff has to land before the loop starts over.",
  },
];
---

<Section id="numbers" title="The numbers">
  <P>
    There is no <code class="code-inline">speed</code>, <code class="code-inline">easing</code> or
    <code class="code-inline">duration</code> option, and there won't be one. The numbers are the product: each one is a
    decision you no longer have to make.
  </P>
  <RefTable aria-label="Timing" columns={["Number", "Why"]} rows={NUMBERS} />
  <P>
    One easing curve, a cubic in-out, drives both the cursor and the camera, so the two never disagree about when a move
    starts or lands.
  </P>
</Section>
