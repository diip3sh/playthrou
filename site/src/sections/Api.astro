---
import C from "../components/C.astro";
import P from "../components/P.astro";
import Section from "../components/Section.astro";
import RefTable, { type RefRow } from "../components/kumo/RefTable";

const STEPS: RefRow[] = [
  { code: ["move(target)"], desc: "Glides the cursor to an element." },
  {
    code: ["click(target?)"],
    desc: "Glides there, presses, ripples and fires real pointer and click events. Without a target it clicks the last one.",
  },
  {
    code: ["type(target?, text)"],
    desc: "Clicks the field, then types into it with human timing. Typed fields restore themselves on every loop.",
  },
  { code: ["key(key)"], desc: "Fires keydown and keyup on the last target, for example key(\"Enter\")." },
  { code: ["zoom(target?)", "zoomOut()"], desc: "Pushes the camera in on an element, or the last target, and pulls it back." },
  { code: ["wait(ms)"], desc: "Holds for a moment." },
  { code: ["run(fn)"], desc: "Runs your own code as a step, with no pause after it." },
  { code: ["reset(fn)"], desc: "Runs before every pass, to put your app back where it started." },
  { code: ["play()", "pause()", "destroy()"], desc: "Controls. destroy() removes the cursor and restores the stage." },
];

const OPTIONS: RefRow[] = [
  { code: ["loop: true"], desc: "Replay forever." },
  { code: ["autoplay: true"], desc: "Start the first time the stage is 30% in view." },
  {
    code: ["pauseOnHover: true"],
    desc: "A real pointer over the stage pauses the demo and hides the fake cursor, so visitors can try it themselves.",
  },
];
---

<Section id="api" title="API">
  <P>
    <C>playthru(stage, options?)</C> takes a selector or an element and returns a chain. Targets are selectors scoped to the
    stage, or elements. They resolve when the step runs, so a step can target something an earlier step created.
  </P>
  <RefTable aria-label="Steps" columns={["Step", "What it does"]} rows={STEPS} />
  <RefTable aria-label="Options" columns={["Option", "What it does"]} rows={OPTIONS} />
  <P>Options say whether, never how. Timing is not an option.</P>
</Section>
