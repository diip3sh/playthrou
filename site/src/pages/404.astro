---
import P from "../components/P.astro";
import Layout from "../layouts/Layout.astro";
import { button } from "../lib/styles";
---

<Layout title="Page not found · playthru" description="There is no page at this address." noindex>
  <main class="mx-auto flex min-h-dvh max-w-173 flex-col items-start justify-center gap-5 px-6 py-24 leading-relaxed">
    <p class="font-mono text-sm text-gray-1100">404</p>
    <h1 class="font-[550] text-gray-1200">Page not found</h1>
    <P>There is no page at this address. The docs for playthru are all on one page.</P>
    <a href="/" class:list={[button, "rounded-full"]}>Back to the docs</a>
  </main>
</Layout>
