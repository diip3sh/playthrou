---
import { Button, LinkButton } from "@cloudflare/kumo/components/button";
import { REPO } from "../lib/links";
import Icon from "./Icon.astro";
import CopyPageMenu from "./kumo/CopyPageMenu";

const pageUrl = new URL(Astro.url.pathname, Astro.site).href;

// The icons follow `data-mode` through the dark variant, so the toggle needs no client state.
const swap = "absolute inset-0 size-[18px] transition-[opacity,scale,filter] duration-200 ease-out";
---

<header class="flex min-h-9 w-full items-center justify-between gap-2 select-none print:hidden">
  <LinkButton href={REPO} aria-label="playthru on GitHub" variant="secondary" shape="circle">
    <Icon name="github" class="size-[18px]" />
  </LinkButton>
  <div class="flex items-center gap-2">
    <Button id="theme-toggle" data-testid="theme-toggle" aria-label="Switch to dark mode" variant="secondary" shape="circle">
      <span class="relative block size-[18px]" aria-hidden="true">
        <Icon name="moon" class={`${swap} scale-100 opacity-100 blur-[0px] dark:scale-50 dark:opacity-0 dark:blur-[2px]`} />
        <Icon name="sun" class={`${swap} scale-50 opacity-0 blur-[2px] dark:scale-100 dark:opacity-100 dark:blur-[0px]`} />
      </span>
    </Button>
    <CopyPageMenu client:load pageUrl={pageUrl} />
  </div>
</header>
