---
import { REPO } from "../lib/links";
import { iconButton } from "../lib/styles";
import CopyButton from "./CopyButton.astro";
import Icon from "./Icon.astro";

// The icons follow `data-theme` through the dark variant, so the toggle needs no client state.
const swap = "absolute size-[18px] transition-[opacity,scale,filter] duration-200 ease-out";
---

<header class="flex min-h-9 w-full items-center justify-between gap-2 select-none">
  <a href={REPO} aria-label="playthru on GitHub" class={iconButton}>
    <Icon name="github" class="size-4" />
  </a>
  <div class="flex items-center gap-2">
    <button
      type="button"
      id="theme-toggle"
      data-testid="theme-toggle"
      aria-label="Switch to dark mode"
      class:list={[iconButton, "relative"]}
    >
      <Icon name="moon" class={`${swap} scale-100 opacity-100 blur-[0px] dark:scale-50 dark:opacity-0 dark:blur-[2px]`} />
      <Icon name="sun" class={`${swap} scale-50 opacity-0 blur-[2px] dark:scale-100 dark:opacity-100 dark:blur-[0px]`} />
    </button>
    <CopyButton label="Copy link to this page" copiedLabel="Link copied" class={`group ${iconButton}`} />
  </div>
</header>
