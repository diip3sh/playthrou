---
/** Phosphor icons, the set Kumo is built around, rendered to static SVG. */
import {
  ArrowUpRightIcon,
  CheckIcon,
  CopyIcon,
  GithubLogoIcon,
  LinkIcon,
  MoonIcon,
  PlusIcon,
  SunIcon,
  TerminalWindowIcon,
  XIcon,
} from "@phosphor-icons/react/dist/ssr";

const ICONS = {
  "arrow-up-right": ArrowUpRightIcon,
  check: CheckIcon,
  copy: CopyIcon,
  github: GithubLogoIcon,
  link: LinkIcon,
  moon: MoonIcon,
  plus: PlusIcon,
  sun: SunIcon,
  terminal: TerminalWindowIcon,
  x: XIcon,
};

interface Props {
  name: keyof typeof ICONS;
  class?: string;
  weight?: "regular" | "bold" | "fill";
}

const { name, class: className, weight = "regular" } = Astro.props;
const Glyph = ICONS[name];
---

<Glyph className={className} weight={weight} aria-hidden="true" />
