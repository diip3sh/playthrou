---
/** The site's icon set (icons.tsx), rendered to static SVG. */
import {
  ArrowUpRightIcon,
  CheckIcon,
  CopyIcon,
  GithubIcon,
  LinkIcon,
  MoonIcon,
  PlusIcon,
  SunIcon,
  TerminalIcon,
  XIcon,
} from "./icons";

const ICONS = {
  "arrow-up-right": ArrowUpRightIcon,
  check: CheckIcon,
  copy: CopyIcon,
  github: GithubIcon,
  link: LinkIcon,
  moon: MoonIcon,
  plus: PlusIcon,
  sun: SunIcon,
  terminal: TerminalIcon,
  x: XIcon,
};

interface Props {
  name: keyof typeof ICONS;
  class?: string;
}

const { name, class: className } = Astro.props;
const Glyph = ICONS[name];
---

<Glyph className={className} />
