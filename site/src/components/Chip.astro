---
import type { HTMLAttributes } from "astro/types";
import { chip } from "../lib/styles";

interface Props extends HTMLAttributes<"span"> {
  tone?: "neutral" | "accent";
}

const { tone = "neutral", class: className, ...rest } = Astro.props;
---

<span class:list={[chip.base, chip[tone], className]} {...rest}><slot /></span>
