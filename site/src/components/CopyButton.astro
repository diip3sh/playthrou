---
import { Button } from "@cloudflare/kumo/components/button";
import { copySwap } from "../lib/styles";
import Icon from "./Icon.astro";

interface Props {
  label: string;
  text: string;
}

const { label, text } = Astro.props;
---

<Button variant="ghost" size="sm" shape="square" className="print:hidden" aria-label={label} data-copy={text}>
  <span class="relative block size-4 text-kumo-subtle transition-colors group-hover:text-kumo-default" aria-hidden="true">
    <Icon name="copy" class={copySwap.copy} />
    <Icon name="check" class={copySwap.check} />
  </span>
  <span class="sr-only" aria-live="polite" data-copy-status></span>
</Button>
