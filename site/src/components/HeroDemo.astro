---
/**
 * The hero is a real playthru demo. The step badges light up as the script
 * reaches them, and the camera checkbox rebuilds the script with or without
 * zoom steps. The UI is Kumo: its components render to static HTML here, and
 * only the checkbox hydrates.
 */
import { Badge } from "@cloudflare/kumo/components/badge";
import { Button } from "@cloudflare/kumo/components/button";
import { Input } from "@cloudflare/kumo/components/input";
import * as styles from "../lib/styles";
import Icon from "./Icon.astro";
import CameraCheckbox from "./kumo/CameraCheckbox";
import LayeredCard from "./kumo/LayeredCard";

const steps: Array<{ label: string; camera?: boolean }> = [
  { label: "click" },
  { label: "zoom", camera: true },
  { label: "type" },
  { label: "click" },
  { label: "zoomOut", camera: true },
  { label: "zoom", camera: true },
];

// The script toggles `data-active` on the wrapper, because Badge doesn't forward attributes.
const active =
  "font-mono transition-[color,background-color,border-color,opacity] duration-200 ease-out in-data-active:border-kumo-brand in-data-active:bg-kumo-info-tint in-data-active:text-kumo-link";
const noCamera = "group-data-[camera=off]/hero:opacity-35 group-data-[camera=off]/hero:line-through";

const ring = {
  open: "border-kumo-interact",
  half: "border-kumo-warning bg-[conic-gradient(var(--color-kumo-warning)_0_50%,transparent_0)]",
  done: "border-kumo-brand bg-kumo-brand",
};

type Tag = "error" | "neutral" | "success";
const issues: Array<{ id: string; title: string; label: string; tag: Tag; state: keyof typeof ring }> = [
  { id: "PT-12", title: "Billing shows a stale plan after upgrade", label: "Bug", tag: "error", state: "half" },
  { id: "PT-11", title: "Keyboard shortcut sheet", label: "Feature", tag: "neutral", state: "open" },
  { id: "PT-9", title: "Tighten empty state spacing", label: "Polish", tag: "success", state: "done" },
  { id: "PT-7", title: "Export issues as CSV", label: "Feature", tag: "neutral", state: "open" },
];

const row = "flex items-center gap-3 px-3 py-2.5 text-sm";
const dot = "size-3 shrink-0 rounded-full border-[1.5px]";
const issueId = "w-10 shrink-0 font-mono text-[11px] text-kumo-subtle";
const issueTitle = "min-w-0 flex-1 truncate text-kumo-strong";
// Kumo draws the primary button's hover on an inner gradient layer; mirror it for the fake cursor.
const primaryHover = "data-playthru-hover:[&>span[aria-hidden]]:from-(--kumo-button-emphasis-bg)";
---

<figure id="hero-demo" class:list={[styles.figure, "group/hero print:hidden"]} data-md="skip">
  <LayeredCard
    className="w-full"
    headerClassName="justify-center py-4"
    bodyClassName="gap-0 p-0 pr-0"
    footerClassName="justify-center gap-6 py-2"
  >
    <div slot="header" class="flex flex-wrap justify-center gap-1.5" role="group" aria-label="Script steps">
      {
        steps.map((s) => (
          <span data-step class="contents">
            <Badge variant="outline" className={[active, s.camera ? noCamera : ""].join(" ")}>
              {s.label}
            </Badge>
          </span>
        ))
      }
    </div>

    <div id="hd-stage" class="h-[340px] w-full">
      <div class="h-full px-4 py-8 sm:px-14">
        <div
          id="hd-app"
          class="group/app mx-auto flex h-full max-w-[440px] flex-col overflow-hidden rounded-lg bg-kumo-base text-left shadow-xs ring ring-kumo-line"
        >
          <div class="flex items-center justify-between border-b border-kumo-hairline bg-kumo-elevated px-3 py-2">
            <span class="text-sm font-medium text-kumo-strong">Issues</span>
            <Button id="hd-new" size="sm" variant="secondary" className="data-playthru-hover:bg-kumo-tint">
              <Icon name="plus" weight="bold" class="size-3" />
              New issue
            </Button>
          </div>
          <div
            id="hd-composer"
            class="hidden items-center gap-2 border-b border-kumo-hairline px-3 py-2 transition-colors duration-200 group-data-open/app:flex has-[[data-playthru-focus]]:bg-kumo-info-tint"
          >
            <Input
              id="hd-title"
              size="sm"
              placeholder="Issue title"
              autoComplete="off"
              aria-label="Issue title"
              className="min-w-0 flex-1 data-playthru-focus:ring-[1.5px] data-playthru-focus:ring-kumo-focus/50"
            />
            <Button id="hd-create" size="sm" variant="primary" className={primaryHover}>Create</Button>
          </div>
          <ul id="hd-list" class="divide-y divide-kumo-hairline">
            {
              issues.map((i) => (
                <li class={row}>
                  <span class:list={[dot, ring[i.state]]} />
                  <span class={issueId}>{i.id}</span>
                  <span class={issueTitle}>{i.title}</span>
                  <Badge variant={i.tag} appearance="dot">
                    {i.label}
                  </Badge>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>

    <template id="hd-row">
      <li
        data-new
        class:list={[
          row,
          "bg-kumo-info-tint transition-[opacity,translate,background-color] duration-500 ease-(--ease-smooth) starting:-translate-y-1 starting:opacity-0",
        ]}
      >
        <span class:list={[dot, ring.open]}></span>
        <span class={issueId} data-id></span>
        <span class={issueTitle} data-title></span>
        <Badge variant="error" appearance="dot">Bug</Badge>
      </li>
    </template>

    <Fragment slot="footer">
      <CameraCheckbox client:load target="hero-demo" />
      <Button id="hd-toggle" size="sm" variant="secondary" aria-pressed="false">Pause</Button>
    </Fragment>
  </LayeredCard>
  <figcaption class={styles.caption}>
    This is markup on the page, not a video.<span class="hidden pointer-fine:inline">
      {" "}Hover it to take over.</span
    >
  </figcaption>
</figure>

<script>
  import { playthru, type Playthru } from "playthru";

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const stage = $("hd-stage");
  const app = $("hd-app");
  const list = $("hd-list");
  const title = $<HTMLInputElement>("hd-title");
  const figure = $("hero-demo");
  const toggle = $<HTMLButtonElement>("hd-toggle");
  const template = $<HTMLTemplateElement>("hd-row");
  const chips = Array.from(figure.querySelectorAll<HTMLElement>("[data-step]"));
  const cameraOn = () => figure.dataset.camera !== "off";

  /* ---- a tiny real app ---- */
  let next = 13;
  const close = () => delete app.dataset.open;
  const reset = () => {
    list.querySelectorAll("[data-new]").forEach((n) => n.remove());
    title.value = "";
    next = 13;
    close();
  };
  const create = () => {
    const text = title.value.trim();
    if (!text) return;
    const li = template.content.firstElementChild!.cloneNode(true) as HTMLElement;
    li.querySelector("[data-id]")!.textContent = `PT-${next++}`;
    li.querySelector("[data-title]")!.textContent = text;
    list.prepend(li);
    title.value = "";
    close();
  };
  $("hd-new").addEventListener("click", () => (app.dataset.open = ""));
  $("hd-create").addEventListener("click", create);
  title.addEventListener("keydown", (e) => e.key === "Enter" && create());

  /* ---- the demo ---- */
  const mark = (i: number) => chips.forEach((c, j) => c.toggleAttribute("data-active", j === i));
  let demo: Playthru | null = null;
  let paused = false;

  function build() {
    demo?.destroy();
    reset();
    mark(-1);
    // A paused visitor stays paused across rebuilds; Play starts it.
    const d = playthru(stage, { autoplay: !paused });
    d.run(() => mark(0)).click("#hd-new");
    if (cameraOn()) d.run(() => mark(1)).zoom("#hd-composer");
    d.run(() => mark(2)).type("#hd-title", "Fix onboarding flicker on Safari");
    d.run(() => mark(3)).click("#hd-create");
    if (cameraOn()) d.run(() => mark(4)).zoomOut().run(() => mark(5)).zoom("[data-new]");
    d.run(() => mark(-1)).reset(() => {
      reset();
      mark(-1);
    });
    demo = d;
  }

  figure.addEventListener("camera-change", build);
  toggle.addEventListener("click", () => {
    paused = !paused;
    paused ? demo?.pause() : demo?.play();
    toggle.textContent = paused ? "Play" : "Pause";
    toggle.setAttribute("aria-pressed", String(paused));
  });

  build();
</script>
